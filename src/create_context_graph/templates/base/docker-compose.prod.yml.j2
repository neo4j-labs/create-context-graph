# {{ domain.name }} Context Graph — Production Docker Compose
# Generated by create-context-graph
#
# Usage:
#   docker compose -f docker-compose.prod.yml up --build -d

services:
  neo4j:
    image: neo4j:5.26.30
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      NEO4J_AUTH: neo4j/${NEO4J_PASSWORD:-password}
      NEO4J_PLUGINS: '["apoc", "graph-data-science"]'
      NEO4J_dbms_security_procedures_unrestricted: apoc.*,gds.*
    volumes:
      - neo4j_data:/data
    healthcheck:
      test: ["CMD-SHELL", "neo4j status || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    build:
      context: ./backend
      dockerfile: ../Dockerfile.backend
    ports:
      - "${BACKEND_PORT:-8000}:8000"
    environment:
      MEMORY_BACKEND: {{ memory_backend }}
{% if is_nams %}
      MEMORY_API_KEY: ${MEMORY_API_KEY}
      MEMORY_NAMS_ENDPOINT: {{ nams_endpoint }}
{% endif %}
      NEO4J_URI: bolt://neo4j:7687
      NEO4J_USERNAME: neo4j
      NEO4J_PASSWORD: ${NEO4J_PASSWORD:-password}
{% if framework in ['anthropic-tools', 'claude-agent-sdk', 'pydanticai', 'langgraph', 'strands', 'crewai'] %}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
{% endif %}
{% if framework == 'openai-agents' %}
      OPENAI_API_KEY: ${OPENAI_API_KEY}
{% endif %}
{% if framework == 'google-adk' %}
      GOOGLE_API_KEY: ${GOOGLE_API_KEY}
{% endif %}
      # Optional: override the agent model ids baked into backend/app/config.py
      ANTHROPIC_MODEL: ${ANTHROPIC_MODEL:-}
      OPENAI_MODEL: ${OPENAI_MODEL:-}
      GEMINI_MODEL: ${GEMINI_MODEL:-}
      CORS_ORIGINS: http://localhost:${FRONTEND_PORT:-3000}
    depends_on:
      neo4j:
        condition: service_healthy

  frontend:
    build:
      context: ./frontend
      dockerfile: ../Dockerfile.frontend
      args:
        NEXT_PUBLIC_API_URL: http://localhost:${BACKEND_PORT:-8000}/api
    ports:
      - "${FRONTEND_PORT:-3000}:3000"
    depends_on:
      - backend

volumes:
  neo4j_data:
