# {{ domain.name }} Context Graph Application
# Generated by create-context-graph

-include .env
export

.PHONY: start dev dev-backend dev-frontend install schema seed reset test-connection clean test test-e2e lint docker-build docker-prod-up docker-prod-down

# Start both backend and frontend
start:
	@echo "Starting {{ domain.name }} Context Graph..."
	@trap 'kill 0' EXIT; \
		$(MAKE) dev-backend & \
		$(MAKE) dev-frontend & \
		wait

dev: start

# Backend
dev-backend:
{% if framework in ['crewai', 'strands'] %}
	cd backend && uv run uvicorn app.main:app --reload --port $${BACKEND_PORT:-8000} --loop asyncio
{% else %}
	cd backend && uv run uvicorn app.main:app --reload --port $${BACKEND_PORT:-8000}
{% endif %}

install-backend:
	cd backend && uv sync --extra dev

# Frontend
dev-frontend:
	cd frontend && NEXT_PUBLIC_API_URL=http://localhost:$${BACKEND_PORT:-8000}/api npm run dev -- --port $${FRONTEND_PORT:-3000}

install-frontend:
	cd frontend && npm install

# Install everything
install: install-backend install-frontend

# Apply Neo4j schema constraints and indexes only (no data)
schema:
	cd backend && uv run python -c "import asyncio; from scripts.generate_data import apply_schema; asyncio.run(apply_schema())"

# Apply schema and ingest fixtures.json into Neo4j (real data if present, otherwise dummy data)
seed:
	cd backend && uv run python scripts/generate_data.py

{% if is_nams %}
# NAMS REST (and neo4j-agent-memory <=0.5.x) expose no entity delete API,
# so there is nothing a client-side reset can remove.
reset:
	@echo "NAMS exposes no delete API (neo4j-agent-memory 0.5.x) — reset is not available from the CLI."
	@echo "Manage stored data at https://memory.neo4jlabs.com, or use a --self-hosted scaffold for full control."

# Test NAMS connection
test-connection:
	@cd backend && uv run python -c "import asyncio; from app.memory import connect_memory, close_memory, get_client; \
async def _check(): \
    await connect_memory(); \
    c = get_client(); \
    print('NAMS connection successful' if c is not None else 'NAMS connection failed'); \
    await close_memory(); \
asyncio.run(_check())"
{% else %}
# Reset Neo4j data (drop and recreate)
reset:
	cd backend && uv run python -c "from app.context_graph_client import reset_database; import asyncio; asyncio.run(reset_database())"

# Test Neo4j connection
test-connection:
	@cd backend && uv run python -c "import asyncio; from app.context_graph_client import connect_neo4j; asyncio.run(connect_neo4j()); print('Neo4j connection successful')" \
		|| echo "Connection failed. Check NEO4J_URI, NEO4J_USERNAME, NEO4J_PASSWORD in .env"
{% endif %}

{% if neo4j_type == 'docker' %}
# Docker Neo4j
docker-up:
	docker compose up -d

docker-down:
	docker compose down
{% endif %}

{% if neo4j_type == 'local' %}
# Local Neo4j (no Docker required)
neo4j-start:
	@echo "Starting Neo4j in background..."
	@npx --yes @johnymontana/neo4j-local start > /tmp/neo4j-local.log 2>&1 & \
		sleep 2 && npx --yes @johnymontana/neo4j-local status

neo4j-stop:
	npx --yes @johnymontana/neo4j-local stop

neo4j-status:
	npx --yes @johnymontana/neo4j-local status
{% endif %}

{% if with_mcp %}
{% if is_nams %}
# MCP Server for Claude Desktop (NAMS backend)
mcp-server:  ## Start MCP server for Claude Desktop (NAMS)
	# The ``neo4j-agent-memory`` console script (extras [cli,mcp]) is the entry
	# point that knows about the NAMS backend; ``python -m neo4j_agent_memory.mcp.server``
	# is bolt-only and has no --backend flag.
	cd backend && MEMORY_API_KEY=$${MEMORY_API_KEY} MEMORY_ENDPOINT={{ nams_endpoint }} \
		uv run neo4j-agent-memory mcp serve \
		--backend nams \
		--profile {{ mcp_profile }}
{% else %}
# MCP Server for Claude Desktop (bolt backend)
mcp-server:  ## Start MCP server for Claude Desktop
	cd backend && uv run neo4j-agent-memory mcp serve \
		--backend bolt \
		--uri $${NEO4J_URI:-neo4j://localhost:7687} \
		--password $${NEO4J_PASSWORD:-password} \
		--profile {{ mcp_profile }}
{% endif %}
{% endif %}

{% if saas_connectors %}
# Fetch from connected services and ingest into the configured memory backend
# (NAMS or self-hosted bolt). Idempotent: each connector tracks a watermark in
# .context-graph/watermarks.json so re-runs only fetch deltas.
import:
	cd backend && uv run python scripts/import_data.py

# Fetch only (no ingest). Writes data/fixtures.json for inspection.
import-dry-run:
	cd backend && uv run python scripts/import_data.py --dry-run

# Drain .context-graph/deadletter.jsonl back through the writer. Use after an
# outage / partial-failure import to re-attempt the failed records.
import-retry:
	cd backend && uv run python scripts/import_data.py --retry
{% endif %}

# Test
test:
	cd backend && uv run python -m pytest tests/ -v 2>/dev/null || echo "No backend tests found"
	cd frontend && npm test 2>/dev/null || echo "No frontend tests found"

# End-to-end tests (requires backend + frontend running, and Playwright installed)
test-e2e:
	cd frontend && npx playwright install --with-deps chromium 2>/dev/null; npm run test:e2e

# Lint
lint:
	cd backend && uv run ruff check app/ 2>/dev/null || echo "Install ruff for linting: uv pip install ruff"
	cd frontend && npm run lint 2>/dev/null || echo "No frontend lint configured"

# Docker production deployment
docker-build:
	docker compose -f docker-compose.prod.yml build

docker-prod-up:
	docker compose -f docker-compose.prod.yml up -d

docker-prod-down:
	docker compose -f docker-compose.prod.yml down

# Clean build artifacts
clean:
	rm -rf backend/__pycache__ backend/.venv
	rm -rf frontend/.next frontend/node_modules
