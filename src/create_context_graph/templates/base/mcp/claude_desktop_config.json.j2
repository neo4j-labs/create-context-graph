{% if is_nams %}
{
  "mcpServers": {
    "{{ project_slug }}-memory": {
      "command": "uv",
      "args": [
        "run",
        "--directory", "./backend",
        "neo4j-agent-memory", "mcp", "serve",
        "--backend", "nams",
        "--profile", "{{ mcp_profile }}"
      ],
      "env": {
        "MEMORY_API_KEY": "${MEMORY_API_KEY}",
        "MEMORY_ENDPOINT": "{{ nams_endpoint }}"
      }
    }
  }
}
{% else %}
{
  "mcpServers": {
    "{{ project_slug }}-memory": {
      "command": "uv",
      "args": [
        "run",
        "--directory", "./backend",
        "neo4j-agent-memory", "mcp", "serve",
        "--backend", "bolt",
        "--uri", "${NEO4J_URI}",
        "--password", "${NEO4J_PASSWORD}",
        "--profile", "{{ mcp_profile }}"
      ]
    }
  }
}
{% endif %}
