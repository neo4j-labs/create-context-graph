FROM python:3.13-slim AS base

WORKDIR /app

# uv is pinned (Astral's documented best practice); bump deliberately.
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Copy dependency files first for better layer caching. When a uv.lock is
# present (created by `make install`), the image installs exactly the locked
# versions; otherwise it resolves fresh — commit backend/uv.lock for
# reproducible images.
COPY pyproject.toml uv.lock* ./
RUN if [ -f uv.lock ]; then \
        uv sync --locked --no-dev --no-install-project; \
    else \
        uv sync --no-dev --no-install-project; \
    fi
{% if not is_nams %}
# Local extraction/embedding models are downloaded on first use; mount a
# volume at HF_HOME (or pre-fetch here) to avoid re-downloading per container.
ENV HF_HOME=/app/.cache/huggingface
{% endif %}

# Copy application code
COPY . .

EXPOSE 8000

{% if framework in ['crewai', 'strands'] %}
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--loop", "asyncio"]
{% else %}
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
{% endif %}
