// GDS Graph Projections for {{ domain.name }}
// Generated by create-context-graph
// Note: Requires Neo4j GDS plugin (AuraDS or Enterprise + GDS)

// Full entity projection (all ontology node labels and relationship types).
// Cypher projection: native projections are slated for deprecation in GDS.
MATCH (s)
WHERE any(l IN labels(s) WHERE l IN [{% for et in entity_types %}'{{ et.label }}'{% if not loop.last %}, {% endif %}{% endfor %}])
OPTIONAL MATCH (s)-[r]->(t)
WHERE type(r) IN [{% for rel in relationships %}'{{ rel.type }}'{% if not loop.last %}, {% endif %}{% endfor %}]
  AND any(l IN labels(t) WHERE l IN [{% for et in entity_types %}'{{ et.label }}'{% if not loop.last %}, {% endif %}{% endfor %}])
WITH gds.graph.project('{{ domain.id | replace("-", "_") }}_full', s, t) AS g
RETURN g.graphName AS graph, g.nodeCount AS nodes, g.relationshipCount AS relationships;

// Community detection
CALL gds.louvain.write('{{ domain.id | replace("-", "_") }}_full', {
  writeProperty: 'community'
});

// PageRank centrality
CALL gds.pageRank.write('{{ domain.id | replace("-", "_") }}_full', {
  writeProperty: 'pagerank'
});

// FastRP embeddings for structural similarity
CALL gds.fastRP.write('{{ domain.id | replace("-", "_") }}_full', {
  embeddingDimension: 128,
  writeProperty: 'fastrp_embedding'
});

// Clean up projection
CALL gds.graph.drop('{{ domain.id | replace("-", "_") }}_full');
